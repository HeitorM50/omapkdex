#!/usr/bin/env python3
"""Resolve uma linha evolutiva na PokéAPI e baixa os sprites dela.

Este é o único lugar do plugin que fala HTTP. O QML dispara este helper por
Process e observa o JSON que ele escreve, na mesma divisão de trabalho do
bin/gcal-sync: credencial e rede ficam fora do processo do shell.

Subcomandos:
  absorb <dif>     acumula os tokens novos dos records e avança a progressão
  details <id>     busca e cacheia os dados de espécie do perfil do indivíduo
  buy <item> <dif> [grau]   compra na loja (rareCandy|mint|shinyCharm|egg)
  use <item> <dif>          usa um item da bag (rareCandy|mint)
  hatch            sorteia uma espécie base, resolve a linha e baixa os sprites
  sprites <ids>    (re)baixa os sprites dessas espécies
  index            reconstrói o índice de candidatos e sai

A saída canônica é companion.json no diretório de estado. A escrita é atômica
(tmp + os.replace) porque o FileView do QML observa o arquivo e não pode ler um
JSON pela metade.
"""

from __future__ import annotations

import datetime as _dt
import fcntl
import json
import os
import random
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

MODULE = "io.github.heitorm50.omapkdex"

API = "https://pokeapi.co/api/v2"
SPRITES = "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon"

# Gen 1-5. O original limita o pool de chocagem a essas gerações porque são as
# que têm sprite animado Black/White.
MAX_SPECIES = 649

# Hosts que o helper aceita seguir. A PokéAPI devolve URLs absolutas em
# evolution_chain.url, e seguir cegamente uma URL vinda da rede é como o
# original acabou com PokeAPIClient.validatedChainURL.
ALLOWED_HOSTS = {"pokeapi.co", "graphql.pokeapi.co", "raw.githubusercontent.com"}

USER_AGENT = f"{MODULE} (+https://github.com/HeitorM50)"
TIMEOUT = 20

# Limiares de capture_rate -> raridade, de CompanionModel.swift:78.
# Um capture_rate menor significa mais difícil de capturar, logo mais raro.
RARITY_CEILINGS = [("rare", 45), ("uncommon", 120), ("common", 255)]


def state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "omarchy", MODULE)


def cache_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "omarchy", MODULE)


def sprite_dir() -> str:
    return os.path.join(cache_dir(), "sprites")


def log(*parts: object) -> None:
    print(f"[{MODULE}]", *parts, file=sys.stderr)


def notify(title: str, body: str = "") -> None:
    """Notificação de desktop. O serviço do omarchy renderiza as do notify-send.

    Falhar aqui nunca pode derrubar o helper: perder uma notificação é bem menos
    grave que travar a progressão por causa dela.
    """
    try:
        subprocess.run(["notify-send", "-a", "PokeTokenBar", title, body],
                       check=False, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as exc:  # noqa: BLE001
        log(f"notificação falhou: {exc}")


def write_atomic(path: str, payload: bytes) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    try:
        with open(tmp, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except BaseException:
        # A troca falhando deixava o temporário para trás — quatro deles
        # apareceram no cache depois de um teste de escrita impedida. O
        # `finally` não serve: quando a troca dá certo, o tmp já não existe.
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_json(path: str, data: object) -> None:
    write_atomic(path, json.dumps(data, ensure_ascii=False, indent=2).encode())


def check_host(url: str) -> str:
    """Valida o host antes de seguir uma URL vinda da rede."""
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https" or parsed.hostname not in ALLOWED_HOSTS:
        raise ValueError(f"URL fora da allowlist: {url}")
    return url


def fetch(url: str, *, binary: bool = False, retries: int = 3):
    check_host(url)
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    last: Exception | None = None
    for attempt in range(retries):
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
                raw = response.read()
            return raw if binary else json.loads(raw)
        except urllib.error.HTTPError as exc:
            # 404 é resposta, não falha transitória: várias espécies simplesmente
            # não têm sprite animado, e insistir só atrasa a chocagem.
            if exc.code == 404:
                raise
            last = exc
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            last = exc
        if attempt + 1 < retries:
            time.sleep(1.5 * (attempt + 1))
    raise last if last else RuntimeError(f"falha ao buscar {url}")


# ---- Índice de candidatos -------------------------------------------------
#
# Chocar precisa de (id, capture_rate) para todas as espécies base. Buscar 649
# species pela REST é lento (649 requisições), então a primeira escolha é o
# GraphQL, que resolve numa tacada, com a REST como plano B. O índice é
# persistido: só é reconstruído se o cache não existir.

GRAPHQL_ENDPOINT = "https://graphql.pokeapi.co/v1beta2"
GRAPHQL_QUERY = """
query BaseSpecies($limit: Int!) {
  pokemonspecies(
    where: {id: {_lte: $limit}, evolves_from_species_id: {_is_null: true}}
    order_by: {id: asc}
  ) {
    id
    name
    capture_rate
    is_legendary
    is_mythical
  }
}
"""


def index_path() -> str:
    return os.path.join(cache_dir(), "base-species.json")


def fetch_index_graphql() -> list[dict]:
    check_host(GRAPHQL_ENDPOINT)
    body = json.dumps({"query": GRAPHQL_QUERY, "variables": {"limit": MAX_SPECIES}})
    request = urllib.request.Request(
        GRAPHQL_ENDPOINT,
        data=body.encode(),
        headers={"User-Agent": USER_AGENT, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        payload = json.loads(response.read())
    rows = (payload.get("data") or {}).get("pokemonspecies") or []
    out = []
    for row in rows:
        rate = row.get("capture_rate")
        if not isinstance(rate, int):
            continue
        out.append(
            {
                "id": row["id"],
                "name": row.get("name") or str(row["id"]),
                "captureRate": rate,
                "isLegendary": bool(row.get("is_legendary")),
                "isMythical": bool(row.get("is_mythical")),
            }
        )
    if not out:
        raise RuntimeError("GraphQL devolveu índice vazio")
    return out


def fetch_index_rest() -> list[dict]:
    """Plano B: uma requisição por espécie. Lento, mas só roda uma vez."""
    log("GraphQL indisponível, reconstruindo índice pela REST (pode levar ~2 min)")
    out = []
    for species_id in range(1, MAX_SPECIES + 1):
        try:
            data = fetch(f"{API}/pokemon-species/{species_id}")
        except Exception as exc:  # noqa: BLE001 - uma espécie faltando não é fatal
            log(f"espécie {species_id} ignorada: {exc}")
            continue
        if data.get("evolves_from_species"):
            continue  # só formas base entram no pool de chocagem
        rate = data.get("capture_rate")
        if not isinstance(rate, int):
            continue
        out.append(
            {
                "id": data["id"],
                "name": data.get("name") or str(data["id"]),
                "captureRate": rate,
                "isLegendary": bool(data.get("is_legendary")),
                "isMythical": bool(data.get("is_mythical")),
            }
        )
    return out


def load_index(*, rebuild: bool = False) -> list[dict]:
    path = index_path()
    if not rebuild and os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as handle:
                cached = json.load(handle)
            if isinstance(cached, list) and cached:
                return cached
        except (OSError, json.JSONDecodeError):
            pass

    try:
        entries = fetch_index_graphql()
    except Exception as exc:  # noqa: BLE001
        log(f"GraphQL falhou ({exc})")
        entries = fetch_index_rest()

    if not entries:
        raise RuntimeError("não foi possível construir o índice de espécies base")
    write_json(path, entries)
    return entries


# ---- Raridade e sorteio ---------------------------------------------------


def rarity_for(entry: dict) -> str:
    if entry.get("isLegendary") or entry.get("isMythical"):
        return "legendary"
    rate = entry["captureRate"]
    for name, ceiling in RARITY_CEILINGS:
        if rate <= ceiling:
            return name
    return "common"


def hatch_weights(entries: list[dict], collection: dict) -> list[int]:
    """Pesos de sorteio: capture_rate, pela metade em linha já coletada.

    capture_rate é literalmente a facilidade de captura no jogo (3 = lendário,
    255 = Rattata), então usá-lo como peso dá de graça a curva que o original
    descreve. A metade para linhas já coletadas empurra espécie nova sem proibir
    repetição — e nunca zera, senão uma coleção grande travaria o sorteio.
    """
    out = []
    for entry in entries:
        weight = max(1, int(entry.get("captureRate") or 1))
        if has_graduated_line(collection, entry.get("id")):
            weight = max(1, weight // 2)
        out.append(weight)
    return out


def pick_species(entries: list[dict], *, tier: str | None = None,
                 collection: dict | None = None) -> dict | None:
    """Sorteia uma espécie base. `tier` é um piso de raridade garantido.

    O piso é um teto de capture_rate (meets_tier), fonte única em
    RARITY_CEILINGS. Devolve None quando o piso não tem candidato: o original
    nunca cai de volta para o pool inteiro, porque isso entregaria menos do que
    a pessoa pagou — ela mantém a garantia e tenta de novo.
    """
    pool = [e for e in entries if meets_tier(e, tier)] if tier else entries
    if not pool:
        return None
    weights = hatch_weights(pool, collection or empty_collection())
    return random.choices(pool, weights=weights, k=1)[0]


# ---- Linha evolutiva ------------------------------------------------------


def evolution_line(base_id: int) -> list[dict]:
    """A sequência de espécies da linha, da forma base à final.

    Ramificações (Eevee, Gardevoir/Gallade) são resolvidas escolhendo um ramo
    ao acaso, para que a linha seja sempre uma lista linear — o painel desenha
    uma progressão, não uma árvore.
    """
    species = fetch(f"{API}/pokemon-species/{base_id}")
    chain_url = (species.get("evolution_chain") or {}).get("url")
    if not chain_url:
        return [{"id": base_id, "name": species.get("name") or str(base_id)}]

    chain = fetch(check_host(chain_url)).get("chain") or {}

    line: list[dict] = []
    node = chain
    while node:
        info = node.get("species") or {}
        name = info.get("name")
        node_id = species_id_from_url(info.get("url"))
        if node_id:
            line.append({"id": node_id, "name": name or str(node_id)})
        nxt = node.get("evolves_to") or []
        node = random.choice(nxt) if nxt else None
    return line or [{"id": base_id, "name": species.get("name") or str(base_id)}]


def species_id_from_url(url: str | None) -> int | None:
    if not url:
        return None
    parts = [p for p in urllib.parse.urlparse(url).path.split("/") if p]
    return int(parts[-1]) if parts and parts[-1].isdigit() else None


# ---- Sprites --------------------------------------------------------------


def sprite_urls(species_id: int, shiny: bool = False) -> list[tuple[str, str]]:
    """As URLs a tentar, em ordem: GIF animado Gen-V e depois o PNG estático.

    O animado não existe para todas as espécies; o PNG existe. As variantes
    shiny vivem em subpastas próprias (SpriteLoader.swift:36-39).
    """
    animated = f"{SPRITES}/versions/generation-v/black-white/animated"
    if shiny:
        return [(f"{animated}/shiny/{species_id}.gif", "gif"),
                (f"{SPRITES}/shiny/{species_id}.png", "png")]
    return [(f"{animated}/{species_id}.gif", "gif"),
            (f"{SPRITES}/{species_id}.png", "png")]


def sprite_cache_name(species_id: int, ext: str, shiny: bool = False) -> str:
    """Nome no cache. Shiny e normal são arquivos distintos da mesma espécie."""
    return f"{species_id}-shiny.{ext}" if shiny else f"{species_id}.{ext}"


def download_sprite(species_id: int, shiny: bool = False) -> str | None:
    """Baixa o sprite da espécie e devolve o caminho local."""
    os.makedirs(sprite_dir(), exist_ok=True)

    for url, ext in sprite_urls(species_id, shiny):
        target = os.path.join(sprite_dir(), sprite_cache_name(species_id, ext, shiny))
        if os.path.exists(target) and os.path.getsize(target) > 0:
            return target
        try:
            write_atomic(target, fetch(url, binary=True))
            return target
        except urllib.error.HTTPError as exc:
            if exc.code == 404:
                continue  # sem sprite animado; tenta o PNG
            log(f"sprite {species_id} ({ext}) falhou: {exc}")
        except Exception as exc:  # noqa: BLE001
            log(f"sprite {species_id} ({ext}) falhou: {exc}")

    return None


def hydrate_sprites(line: list[dict], shiny: bool = False) -> list[dict]:
    """Baixa o sprite de cada forma da linha.

    Um companion shiny mantém as cores shiny em toda a linha evolutiva, como no
    original — então a variante é a mesma para todas as formas. Se a variante
    shiny faltar, cai para a normal em vez de deixar a forma sem sprite.
    """
    for form in line:
        path = download_sprite(form["id"], shiny)
        if path is None and shiny:
            path = download_sprite(form["id"], False)
        if path:
            form["sprite"] = path
    return line


# ---- Economia de tokens ---------------------------------------------------
#
# Portado de PokemonBalance (CompanionModel.swift:104-127 do PokeTokenBar).
# A propriedade que importa: para uma dada raridade o total até a graduação é o
# mesmo independente de quantas formas a linha tem. O que muda é o parcelamento,
# com estágios mais altos custando proporcionalmente mais.

EGG_HATCH_THRESHOLD = 5_000_000

GRADUATION_TOTAL = {
    "common": 750_000_000,
    "uncommon": 1_875_000_000,
    "rare": 3_000_000_000,
    "legendary": 6_000_000_000,
}

DIFFICULTY_MIN, DIFFICULTY_MAX, DIFFICULTY_DEFAULT = 0.1, 2.0, 1.0

# As quatro contagens que o contrato do omarchy.agents define em modelUsage.
TOKEN_KEYS = ("inputTokens", "outputTokens",
              "cacheCreationInputTokens", "cacheReadInputTokens")

AGENT_IDS = ("claude", "codex", "fireworks")


def clamp_difficulty(value) -> float:
    try:
        n = float(value)
    except (TypeError, ValueError):
        return DIFFICULTY_DEFAULT
    if n != n or n in (float("inf"), float("-inf")):
        return DIFFICULTY_DEFAULT
    return min(max(n, DIFFICULTY_MIN), DIFFICULTY_MAX)


def graduation_total(rarity: str) -> int:
    return GRADUATION_TOTAL.get(rarity, GRADUATION_TOTAL["common"])


def hatch_threshold(difficulty: float) -> int:
    return max(1, round(EGG_HATCH_THRESHOLD * clamp_difficulty(difficulty)))


def phase_threshold(rarity: str, total_forms: int, stage_index: int,
                    difficulty: float, growth_multiplier: int = 1) -> int:
    """Custo do estágio stage_index (0-based) numa linha de total_forms formas.

    custo(i) = T * (i+1) / (k*(k+1)/2) — a soma sobre todos os estágios é
    exatamente T, então a graduação cai no total prometido pela raridade sem
    depender do tamanho da linha.
    """
    k = max(1, int(total_forms))
    i = min(max(0, int(stage_index)) + 1, k)
    denom = (k * (k + 1)) / 2
    base = round(graduation_total(rarity) * i / denom)
    scaled = round(base * clamp_difficulty(difficulty))
    # O bônus de linha repetida DIVIDE o limiar (original: `max(1, round(
    # standard / multiplier))`), então 2 significa "cresce duas vezes mais
    # rápido", não "custa o dobro".
    return max(1, round(scaled / max(1, int(growth_multiplier))))


def record_tokens(record: dict) -> int:
    usage = (record or {}).get("modelUsage")
    if not isinstance(usage, dict):
        return 0
    total = 0
    for entry in usage.values():
        if isinstance(entry, dict):
            total += sum(entry.get(k, 0) or 0 for k in TOKEN_KEYS)
    return total


# ---- Estado ---------------------------------------------------------------


def state_path() -> str:
    return os.path.join(state_dir(), "state.json")


def lock_path() -> str:
    return os.path.join(state_dir(), "absorb.lock")


DEFAULT_STATE = {
    "schemaVersion": 1,
    "lifetimeTokens": 0,
    "lastSeen": {},
    "stage": 0,
    "tokensIntoStage": 0,
    "hatched": False,
    "graduations": 0,
    "spentTokens": 0,
    "inventory": {},
    "candyWindows": {},
    "candySeeded": False,
    "eggTier": None,
    "burnRate": 0,
    "lastGainAt": 0,
    # A última dificuldade com que se absorveu. `None` é estado gravado antes
    # deste campo existir — ver rescale_progress.
    "difficulty": None,
}


def load_state() -> dict:
    try:
        with open(state_path(), encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict):
            merged = dict(DEFAULT_STATE)
            merged.update(data)
            if not isinstance(merged.get("lastSeen"), dict):
                merged["lastSeen"] = {}
            if not isinstance(merged.get("inventory"), dict):
                merged["inventory"] = {}
            if not isinstance(merged.get("candyWindows"), dict):
                merged["candyWindows"] = {}
            return merged
    except (OSError, json.JSONDecodeError):
        pass
    return dict(DEFAULT_STATE)


def load_companion() -> dict | None:
    try:
        with open(companion_path(), encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict) and isinstance(data.get("evolutionLine"), list):
            return data
    except (OSError, json.JSONDecodeError):
        pass
    return None


def load_records() -> dict:
    out = {}
    for agent_id in AGENT_IDS:
        path = os.path.join(state_dir(), "..", "agents", "usage", f"{agent_id}.json")
        path = os.path.normpath(path)
        try:
            with open(path, encoding="utf-8") as handle:
                data = json.load(handle)
            if isinstance(data, dict):
                out[agent_id] = data
        except (OSError, json.JSONDecodeError):
            continue
    return out


def cmd_absorb(argv: list[str]) -> int:
    """Acumula os tokens novos dos records e avança a progressão.

    Este é o único escritor de state.json. O bar instancia um widget por
    monitor, e dois widgets acumulando o mesmo delta contariam em dobro — então
    a mutação vive aqui, atrás de um lock, e o QML só observa o arquivo.
    """
    difficulty = clamp_difficulty(argv[0] if argv else DIFFICULTY_DEFAULT)
    seed = len(argv) > 1 and argv[1] == "seed"

    os.makedirs(state_dir(), exist_ok=True)
    with open(lock_path(), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            # Outra instância já está absorvendo esta mesma rajada.
            return 0

        now = int(time.time())
        state = load_state()
        records = load_records()
        companion = load_companion()

        rarity = (companion or {}).get("rarity", "common")
        line = (companion or {}).get("evolutionLine") or []
        total_forms = max(1, len(line))
        boost = growth_boost(load_collection(), companion)

        # Antes de acumular qualquer token: se a dificuldade mudou desde a
        # última absorção, o progresso guardado está em outra escala.
        #
        # `None` é estado anterior a este campo: adota a dificuldade atual SEM
        # reescalar. Tratar a ausência como o default 1.0 multiplicaria por 0.3
        # o progresso de quem já jogava em 0.3 — quem mais sofreria seria
        # justamente quem instalou antes.
        anterior = state.get("difficulty")
        if isinstance(anterior, (int, float)) and float(anterior) != difficulty:
            rescale_progress(state, rarity, total_forms, float(anterior),
                             difficulty, boost)
        state["difficulty"] = difficulty

        seen = state["lastSeen"]
        gained = 0
        for agent_id in AGENT_IDS:
            record = records.get(agent_id)
            if record is None:
                continue
            current = record_tokens(record)
            previous = seen.get(agent_id)
            if not isinstance(previous, (int, float)):
                # Primeira vez que vemos este agente: marcamos a régua. Sem
                # `seed` o histórico já gasto não conta, para o primeiro Pokémon
                # não graduar instantaneamente.
                seen[agent_id] = current
                if seed:
                    gained += current
                continue
            # Só delta positivo. Um record que encolheu (a janela de 30 dias do
            # coletor do Codex, uma CLI desinstalada, um record reescrito)
            # contribui zero, nunca negativo.
            delta = current - previous
            if delta > 0:
                gained += delta
            if delta != 0:
                seen[agent_id] = current

        hatch_requested = False
        graduated = False
        reveal_requested = False
        if gained > 0:
            state["lifetimeTokens"] += gained

            if not state["hatched"]:
                needed = hatch_threshold(difficulty)
                if state["tokensIntoStage"] + gained < needed:
                    state["tokensIntoStage"] += gained
                else:
                    # Chocou. O excedente do ovo é transferido para o
                    # crescimento do filhote, como no original.
                    state["tokensIntoStage"] = state["tokensIntoStage"] + gained - needed
                    state["hatched"] = True
                    state["stage"] = 0
                    if companion is None:
                        hatch_requested = True
            else:
                state["tokensIntoStage"] += gained

            if state["hatched"] and not companion:
                # O estado diz chocado mas não há companion: o sorteio da
                # espécie falhou (rede). Sem linha não há limiar, e o fallback
                # `companion or {}` daria uma linha fantasma de uma forma que
                # gradua quase na hora — já vi acontecer: graduations=1 com a
                # coleção vazia e a notificação de nome vazio.
                state["hatched"] = False
                hatch_requested = True
            elif state["hatched"]:
                # Avança quantos estágios os tokens cobrirem. Um dia pesado pode
                # cobrir mais de um, e avançar só um por execução deixaria
                # tokens presos.
                graduated = advance_stages(state, rarity, total_forms,
                                           difficulty, boost)
                if graduated:
                    hatch_requested = True
                elif (companion.get("dittoDisguise")
                        and not companion.get("dittoRevealed")
                        and state["stage"] >= 1):
                    # A revelação acontece NO LUGAR da primeira evolução, e tem
                    # de vir antes de qualquer graduação: se a espécie do
                    # disfarce graduasse, ela entraria no Pokédex como se o
                    # bicho tivesse sido aquilo o tempo todo.
                    reveal_requested = True

        # Taxa de queima, para o humor do companion.
        #
        # Mede o intervalo entre GANHOS, não entre absorções. Os records do
        # omarchy.agents só são regenerados a cada 900s por padrão, então o delta
        # chega em rajada; dividir pelo intervalo entre absorções (60s) infla a
        # taxa ~15× e deixaria o companion permanentemente "no foco".
        #
        # Uma absorção sem ganho não mexe em nada: reiniciar o cronômetro ali
        # faria o próximo ganho parecer instantâneo.
        if gained > 0:
            anterior = int(state.get("lastGainAt") or 0)
            state["burnRate"] = burn_rate(gained, now - anterior) if anterior else 0
            state["lastGainAt"] = now

        # Candies por janela cheia. Roda a cada absorção, antes da escrita, e
        # é independente de ter havido delta: bater o limite não exige tokens
        # novos nesta passada.
        grants = grant_candies(state, records)

        write_json(state_path(), state)

        # A coleção espelha a progressão. Fica dentro do lock, junto da escrita
        # do estado, para as duas não divergirem se dois absorvedores correrem.
        collection = load_collection()
        touched = False

        if companion:
            # Semeia a entrada de um companion que já existia antes de haver
            # coleção — sem isso, o Pokémon em andamento sumiria do catch log.
            touched |= sync_open_entry(collection, companion, now)

        if graduated:
            touched |= close_open_entry(collection, now, total_forms - 1)
            nome = (companion or {}).get("name", "").replace("-", " ").title()
            notify("🎓 Graduated!", f"{nome} is in the Pokédex for good."
                                    " A fresh egg is on the way.")
        elif state["hatched"]:
            touched |= record_stage(collection, state["stage"])

        if touched:
            save_collection(collection)

        if reveal_requested:
            # O estágio volta a 0 porque a linha do Ditto tem uma forma só; o
            # excedente que sobrou da evolução é o progresso inicial dele.
            state["stage"] = 0
            revealed = reveal_ditto(companion, now)
            if revealed is not None:
                write_json(state_path(), state)
                collection = load_collection()
                # A entrada aberta passa a descrever o Ditto: é o mesmo
                # indivíduo (mesmo companionId), então sync_open_entry a
                # atualiza em vez de abrir outra.
                entry = open_entry(collection)
                if entry is not None:
                    entry["speciesId"] = DITTO_SPECIES_ID
                    entry["name"] = revealed["name"]
                    entry["rarity"] = revealed["rarity"]
                    entry["line"] = [{"id": f.get("id"),
                                      "name": f.get("name") or str(f.get("id")),
                                      "sprite": f.get("sprite") or ""}
                                     for f in revealed["evolutionLine"]
                                     if f.get("id")]
                    entry["finalStage"] = 0
                    # Libera o ✨ no dex e no histórico: até aqui a projeção o
                    # escondia porque a entrada constava disfarçada.
                    entry["dittoRevealed"] = True
                    save_collection(collection)
                notify("🎭 It was a Ditto!",
                       "Your companion was never what it claimed to be."
                       + (" And it is shiny." if revealed.get("shiny") else ""))

        if hatch_requested:
            # cmd_hatch escreve o companion novo e abre a entrada dele, já com a
            # anterior fechada acima. Uma falha de rede aqui não pode abortar a
            # absorção: o estado já está coerente (ovo sem espécie sorteada), e a
            # próxima passada tenta de novo.
            try:
                cmd_hatch([])
            except Exception as exc:  # noqa: BLE001
                log(f"chocagem falhou ({exc}); será tentada na próxima absorção")

    for grant in grants:
        # A notificação diz QUAL janela, como no original — sem isso a pessoa
        # ganha uma candy e não sabe por quê.
        notify("Rare Candy!", f"{grant['count']}x for filling {grant['name']}")

    log(f"absorveu {gained} tokens; lifetime={state['lifetimeTokens']} "
        f"stage={state['stage']} hatched={state['hatched']} "
        f"graduations={state['graduations']}"
        + (f" candies={sum(g['count'] for g in grants)}" if grants else ""))
    return 0


# ---- Economia ------------------------------------------------------------
#
# Constantes portadas verbatim de CompanionModel.swift:213-268. Os dois
# comentários de balanceamento do original são load-bearing e estão replicados
# aqui porque quem mexer nos números vai querer "melhorá-los".

# XP injetado ao usar uma candy. NÃO entra em lifetimeTokens: a carteira é
# lifetimeTokens − spentTokens, então somar isto ao lifetime faria de cada candy
# uma máquina de dinheiro.
RARE_CANDY_XP = 100_000_000

# Preço = 5× o que a candy entrega, de propósito. Os tokens são usados duas
# vezes (medidor de crescimento E carteira); preço igual ao XP tornaria a compra
# um crescimento grátis. A 500M o bônus efetivo cai para ~+20%, e ganhar de
# graça batendo o limite fica sempre melhor que comprar.
RARE_CANDY_PRICE = 500_000_000

# Quantas candies um limite de janela cheio paga.
CANDY_WEEKLY_GRANT = 5
CANDY_SESSION_GRANT = 1

# Trocar a nature é cosmético, sem base de balanceamento — 1/5 da candy para ser
# um brinquedo leve. Não dá crescimento, então não há dupla contagem.
MINT_PRICE = 100_000_000

# Passivo, compra única, permanente: preço de uma graduação `rare`.
SHINY_CHARM_PRICE = 3_000_000_000
# 1/64 -> 1/48 (+33%). O original rejeita explicitamente 1/32 como exagero.
SHINY_CHARM_RATE = 48

# Ovo sem garantia. Descarta o companion e volta à incubação de 5M — a perda do
# progresso acumulado é o custo real, e é o que impede farmar re-rolls.
FRESH_EGG_PRICE = 1_000_000_000

# Graus vendidos. Sem ovo exclusivo de lendário: o piso é um teto de
# capture_rate, e ser lendário vem de is_legendary, que o índice não carrega.
# Como todo lendário tem capture_rate <= 45, ele entra naturalmente nos dois
# graus pagos.
EGG_TIERS = [None, "uncommon", "rare"]

# As 25 natures da série principal. Aqui são só rótulo — sem stats, porque o
# bloco de individualidade ficou fora de escopo. Existem para o Mint ter o que
# re-sortear.
NATURES = [
    "hardy", "lonely", "brave", "adamant", "naughty",
    "bold", "docile", "relaxed", "impish", "lax",
    "timid", "hasty", "serious", "jolly", "naive",
    "modest", "mild", "quiet", "bashful", "rash",
    "calm", "gentle", "sassy", "careful", "quirky",
]


def egg_price(tier: str | None) -> int:
    """Preço do ovo por grau garantido.

    A razão sai da TABELA DE GRADUAÇÃO, não da de probabilidade. Pela
    probabilidade (uncommon 7.16% : rare 6.98%), dois ovos uncommon baterriam um
    rare em todos os eixos e o grau superior viraria bem inferior.
    """
    if tier is None:
        return FRESH_EGG_PRICE
    ratio = graduation_total(tier) / graduation_total("common")
    return round(FRESH_EGG_PRICE * ratio)


BASE_PRICES = {
    "rareCandy": RARE_CANDY_PRICE,
    "mint": MINT_PRICE,
    "shinyCharm": SHINY_CHARM_PRICE,
}

PASSIVE_ITEMS = {"shinyCharm"}


def shop_price(entry: str, shop_difficulty: float) -> int:
    """Preço cobrado. `entry` é um item ou "egg:<grau>".

    A dificuldade da loja é independente da de crescimento, e as tabelas de
    constante nunca são escaladas — só o ponto de consumo, como no original.
    """
    if entry.startswith("egg"):
        _, _, tier = entry.partition(":")
        base = egg_price(tier or None)
    else:
        base = BASE_PRICES.get(entry, 0)
    return max(0, round(base * clamp_difficulty(shop_difficulty)))


def available_tokens(state: dict) -> int:
    """A carteira: tudo o que já foi queimado, menos o que já foi gasto."""
    lifetime = state.get("lifetimeTokens") or 0
    spent = state.get("spentTokens") or 0
    return max(0, int(lifetime) - int(spent))


def shiny_denominator(inventory: dict) -> int:
    return SHINY_CHARM_RATE if (inventory or {}).get("shinyCharm") else SHINY_RATE


def meets_tier(entry: dict, tier: str | None) -> bool:
    """O piso de raridade é um teto de capture_rate, fonte única em
    RARITY_CEILINGS. Lendário passa em qualquer piso porque todo lendário tem
    capture_rate <= 45."""
    if tier is None:
        return True
    ceiling = dict(RARITY_CEILINGS).get(tier)
    if ceiling is None:
        return False
    return int(entry.get("captureRate", 999)) <= ceiling


def has_graduated_line(collection: dict, base_species_id: int) -> bool:
    """A linha desta espécie base já foi levada até o fim e GRADUADA.

    Liberada por compra de ovo não conta: o original não insere em
    collectedFinals nesse caminho, então o descartado aparece no Pokédex mas
    não paga o bônus de 2×.
    """
    for entry in (collection or {}).get("entries") or []:
        if entry.get("speciesId") != base_species_id:
            continue
        if entry.get("graduatedAt") is None:
            continue
        line = entry.get("line") or []
        if line and int(entry.get("finalStage") or 0) >= len(line) - 1:
            return True
    return False


def burn_rate(gained: int, seconds: float) -> int:
    """Tokens por minuto, para o humor do companion.

    Um intervalo longo (máquina suspensa, shell fechado) dilui a taxa a quase
    nada, e isso é o comportamento certo: ninguém estava codando. Intervalo zero
    ou negativo — o relógio pode andar para trás — vira 0 em vez de estourar.
    """
    if seconds <= 0 or gained <= 0:
        return 0
    return int(gained / (seconds / 60.0))


def advance_stages(state: dict, rarity: str, total_forms: int,
                   difficulty: float, growth_multiplier: int = 1) -> bool:
    """Avança quantos estágios os tokens acumulados cobrirem. Devolve se graduou.

    Extraída de cmd_absorb para o `use rareCandy` reaproveitar em vez de
    duplicar a regra. Um dia pesado — ou uma candy de 100M — pode cobrir mais de
    um estágio, e avançar só um por chamada deixaria tokens presos.
    """
    stage = int(state.get("stage") or 0)
    into = int(state.get("tokensIntoStage") or 0)

    while stage < total_forms:
        threshold = phase_threshold(rarity, total_forms, stage, difficulty,
                                    growth_multiplier)
        if into < threshold:
            break
        into -= threshold
        stage += 1

    if stage >= total_forms:
        state["graduations"] = int(state.get("graduations") or 0) + 1
        state["hatched"] = False
        state["stage"] = 0
        # O excedente é descartado de propósito: carregá-lo faria cascata no
        # caso que importa, em que `seed` solta mais de um bilhão de uma vez e
        # graduaria vários Pokémon em sequência contra uma linha que ainda nem
        # foi sorteada. Em uso normal a perda é de no máximo um delta, e só na
        # graduação.
        state["tokensIntoStage"] = 0
        return True

    state["stage"] = stage
    state["tokensIntoStage"] = into
    return False


def rescale_progress(state: dict, rarity: str, total_forms: int,
                     old: float, new: float, growth_multiplier: int = 1) -> None:
    """Reescala o progresso acumulado quando a dificuldade muda.

    A dificuldade não mora no state: vem do shell.json, e muda por fora — pela
    tela de settings do Omarchy ou pela aba de settings do painel. Como
    `tokensIntoStage` é um número ABSOLUTO de tokens e o limiar é derivado na
    hora, baixar a dificuldade encolhe o limiar por baixo do progresso já
    acumulado e o companion gradua de graça (medido: 240M contra limiares de
    75M+150M cobre a linha inteira de uma vez); subir a dificuldade rouba
    progresso em silêncio.

    O que se preserva é a FRAÇÃO do estágio, que é o que a pessoa vê na barra.
    É o mesmo que o original faz em CompanionStore.rescaleBankedGrowth.
    """
    into = int(state.get("tokensIntoStage") or 0)
    if into <= 0:
        return

    if state.get("hatched"):
        stage = int(state.get("stage") or 0)
        antigo = phase_threshold(rarity, total_forms, stage, old, growth_multiplier)
        novo = phase_threshold(rarity, total_forms, stage, new, growth_multiplier)
    else:
        antigo = hatch_threshold(old)
        novo = hatch_threshold(new)

    if antigo == novo or antigo <= 0:
        return

    escalado = int(into * novo / antigo)
    # Arredondar não pode completar um estágio que estava incompleto: a um token
    # do limiar antigo, a proporção cai exatamente sobre o limiar novo, e o
    # reescalonamento entregaria a evolução que ele estava justamente evitando.
    if into < antigo:
        escalado = min(novo - 1, escalado)
    state["tokensIntoStage"] = max(0, escalado)


def growth_boost(collection: dict, companion: dict | None) -> int:
    """2 quando a linha base deste companion já foi graduada, senão 1."""
    if not companion:
        return 1
    base = companion.get("baseSpeciesId")
    return 2 if base and has_graduated_line(collection, base) else 1


# ---- Janelas de limite (Rare Candy) --------------------------------------


def window_key(agent_id: str, limit: dict) -> str:
    """Identidade estável da janela.

    O original proíbe em comentário usar campos voláteis como resets_at, e o
    motivo é observável: o resetsAt do limite de sessão do Claude vem string
    vazia. A chave é agente + label.
    """
    return f"{agent_id}:{limit.get('label') or ''}"


def window_class(limit: dict) -> str:
    """`weekly` ou `session`.

    O original classifica por duração (> 1440 min => weekly). Os records não
    trazem duração, só resetsAt e label, então: mais de 24h à frente => semanal;
    sem resetsAt, cai para o label.
    """
    raw = str(limit.get("resetsAt") or "").strip()
    if raw:
        try:
            when = _dt.datetime.fromisoformat(raw)
            if when.tzinfo is None:
                when = when.replace(tzinfo=_dt.timezone.utc)
            delta = when - _dt.datetime.now(_dt.timezone.utc)
            return "weekly" if delta.total_seconds() > 24 * 3600 else "session"
        except ValueError:
            pass
    return "weekly" if "week" in str(limit.get("label") or "").lower() else "session"


def candy_windows(records: dict) -> list[dict]:
    """Todas as janelas de limite conhecidas, achatadas com a chave e a classe."""
    out = []
    for agent_id, record in (records or {}).items():
        for limit in (record or {}).get("limits") or []:
            if not isinstance(limit, dict) or not isinstance(limit.get("percent"), (int, float)):
                continue
            out.append({
                "key": window_key(agent_id, limit),
                "name": f"{(record.get('name') or agent_id)} · {limit.get('label') or ''}",
                # percent nos records é 0..1; o utilization do original é 0..100.
                "full": float(limit["percent"]) >= 1.0,
                "kind": window_class(limit),
            })
    return out


def grant_candies(state: dict, records: dict) -> list[dict]:
    """Concede candies por janela cheia. Muta `state`, devolve as concessões.

    Regra do original (evaluateCandyGrants): concede quando cheia e a janela não
    está marcada; desmarca quando deixa de estar cheia. Sem histerese — o
    percent de uma janela só cai na virada dela.
    """
    ledger = state.setdefault("candyWindows", {})
    windows = candy_windows(records)

    # Primeira execução: marca tudo o que já está cheio SEM conceder, para ligar
    # a feature com o semanal em 100% não pagar 5 candies retroativas.
    if not state.get("candySeeded"):
        for w in windows:
            if w["full"]:
                ledger[w["key"]] = True
        state["candySeeded"] = True
        return []

    grants = []
    for w in windows:
        if not w["full"]:
            ledger[w["key"]] = False
            continue
        if ledger.get(w["key"]):
            continue
        count = CANDY_WEEKLY_GRANT if w["kind"] == "weekly" else CANDY_SESSION_GRANT
        inventory = state.setdefault("inventory", {})
        inventory["rareCandy"] = int(inventory.get("rareCandy") or 0) + count
        ledger[w["key"]] = True
        grants.append({"name": w["name"], "count": count})
    return grants


# ---- Shiny ----------------------------------------------------------------

# Uma chocagem em 64. O 1/4096 dos jogos daria uma shiny a cada algumas décadas
# no ritmo de uso real desta máquina; o próprio PokeTokenBar já afrouxa a taxa.
SHINY_RATE = 64


def roll_shiny(rng=None, denominator: int = SHINY_RATE) -> bool:
    """Sorteia se a chocagem é shiny.

    Recebe o gerador para os testes poderem fixar o resultado; sem ele usa o
    módulo `random`, que já é semeado pelo interpretador. O denominador vem do
    inventário (48 com Shiny Charm, 64 sem) — ver shiny_denominator.
    """
    source = rng if rng is not None else random
    return source.randrange(max(1, int(denominator))) == 0


# ---- Ditto disfarçado -----------------------------------------------------
#
# 1 em 128 chocagens comuns de linha com 2+ formas é secretamente um Ditto, que
# se revela no lugar da primeira evolução. Enquanto disfarçado o shiny fica
# escondido: revelar um shiny junto com o Ditto é o ponto alto do easter egg, e
# mostrar o brilho antes estragaria a surpresa duas vezes.

DITTO_RATE = 128
DITTO_SPECIES_ID = 132


def roll_ditto(rarity: str, total_forms: int, rng=None) -> bool:
    """Só linhas comuns com 2+ formas disfarçam.

    Comum porque o disfarce é uma promoção (o Ditto tem capture_rate 35, ou
    seja, `rare`); 2+ formas porque a revelação acontece NO LUGAR da primeira
    evolução — sem evolução não há onde revelar.
    """
    if rarity != "common" or int(total_forms) < 2:
        return False
    source = rng if rng is not None else random
    return source.randrange(DITTO_RATE) == 0


def reveal_ditto(companion: dict, now: int) -> dict | None:
    """Troca o companion disfarçado pelo Ditto, preservando o indivíduo.

    Mantém companionId, shiny e nature: é o mesmo bicho, que só nunca foi o que
    dizia ser. A raridade é recalculada da espécie 132, e a linha passa a ter
    uma forma só (Ditto não evolui).
    """
    entry = next((e for e in load_index() if e.get("id") == DITTO_SPECIES_ID), None)
    if entry is None:
        log("espécie 132 fora do índice; a revelação fica para a próxima")
        return None

    line = hydrate_sprites(evolution_line(DITTO_SPECIES_ID),
                           companion.get("shiny") is True)
    revealed = dict(companion)
    revealed.update({
        "baseSpeciesId": DITTO_SPECIES_ID,
        "name": entry.get("name") or "ditto",
        "rarity": rarity_for(entry),
        "captureRate": entry.get("captureRate"),
        "evolutionLine": line,
        "dittoRevealed": True,
        "revealedAt": now,
    })
    write_json(companion_path(), revealed)
    return revealed


# ---- Coleção (catch log) --------------------------------------------------
#
# Uma entrada por indivíduo chocado. O Pokédex de espécies é *projeção* disto,
# calculada na hora de desenhar (Collection.js) — duas coleções persistidas
# dessincronizariam, uma não tem como.
#
# A entrada aberta (graduatedAt None) é sempre o companion atual, e há no
# máximo uma.

COLLECTION_SCHEMA = 1


def collection_path() -> str:
    return os.path.join(state_dir(), "collection.json")


def empty_collection() -> dict:
    return {"schemaVersion": COLLECTION_SCHEMA, "entries": []}


def load_collection() -> dict:
    try:
        with open(collection_path(), encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict) and isinstance(data.get("entries"), list):
            return {"schemaVersion": data.get("schemaVersion", COLLECTION_SCHEMA),
                    "entries": data["entries"]}
    except (OSError, json.JSONDecodeError):
        pass
    # Arquivo ausente, ilegível ou com o formato errado: a coleção volta vazia
    # em vez de derrubar o helper. Perder o histórico é ruim; travar a
    # progressão por causa dele é pior.
    return empty_collection()


def save_collection(collection: dict) -> None:
    write_json(collection_path(), collection)


def companion_key(companion: dict):
    """Identidade do companion, para casar com a entrada de catch log.

    `hatchedAt` tem resolução de um segundo: duas chocagens no mesmo segundo —
    um duplo disparo do widget, por exemplo — colidiriam, e a entrada passaria a
    descrever a espécie errada. Por isso cada companion carrega um id próprio.
    `hatchedAt` fica como fallback para companions da v1, que não tinham id.
    """
    return companion.get("companionId") or companion.get("hatchedAt")


def open_entry(collection: dict) -> dict | None:
    """A entrada do companion atual, se houver.

    Uma entrada está aberta só quando não graduou NEM foi liberada. Sem checar
    `releasedAt` aqui, uma entrada liberada por compra de ovo continuaria
    parecendo aberta, e a chocagem seguinte a fecharia como graduada — dando o
    bônus de 2× a uma linha que foi descartada.
    """
    for entry in collection["entries"]:
        if entry.get("graduatedAt") is None and entry.get("releasedAt") is None:
            return entry
    return None


def entry_from_companion(companion: dict, now: int) -> dict:
    """A entrada de catch log correspondente a um companion recém-chocado."""
    line = companion.get("evolutionLine") or []
    return {
        "companionId": companion_key(companion),
        "speciesId": companion.get("baseSpeciesId"),
        "name": companion.get("name") or "",
        "rarity": companion.get("rarity") or "common",
        # companion.json da v1 não tinha o campo; ausente é normal, não shiny.
        # Guardamos o shiny BRUTO: ele é shiny de verdade. Quem decide se pode
        # ser mostrado é a projeção, que precisa saber do disfarce — por isso os
        # dois campos abaixo viajam com a entrada.
        "shiny": companion.get("shiny") is True,
        "dittoDisguise": companion.get("dittoDisguise") is True,
        "dittoRevealed": companion.get("dittoRevealed") is True,
        # A forma inteira, não só o id: o Pokédex precisa nomear e desenhar
        # espécies que nunca foram forma base de nada — um Crawdaunt não existe
        # no índice de chocagem — e não haveria de onde buscar isso depois.
        "line": [{"id": f.get("id"),
                  "name": f.get("name") or str(f.get("id")),
                  "sprite": f.get("sprite") or ""}
                 for f in line if f.get("id")],
        # A natureza é a única parte do perfil que NÃO sai de um seed: o Mint a
        # re-sorteia, então é mutável e tem de ser gravada. Sem ela aqui, o
        # perfil de um indivíduo já graduado não teria natureza nenhuma — e
        # sortear uma na hora mostraria uma que aquele bicho nunca teve.
        "nature": companion.get("nature"),
        "hatchedAt": companion.get("hatchedAt") or now,
        "graduatedAt": None,
        "finalStage": 0,
    }


def sync_open_entry(collection: dict, companion: dict, now: int) -> bool:
    """Garante que a entrada aberta espelha o companion atual.

    Devolve True se mudou alguma coisa. É idempotente: chamar de novo com o
    mesmo companion não faz nada, o que importa porque o widget pode disparar o
    helper várias vezes na mesma rajada.
    """
    if not companion:
        return False

    key = companion_key(companion)
    changed = False

    # Um companion trocado sem graduar (re-hatch manual, ovo comprado) abandona
    # o anterior. Ele fica no catch log, fechado no estágio a que chegou.
    for entry in collection["entries"]:
        if (entry.get("graduatedAt") is None
                and entry.get("releasedAt") is None
                and entry.get("companionId") != key):
            entry["graduatedAt"] = now
            changed = True

    # Um companionId que já está na coleção — em QUALQUER estado — nunca é
    # reaberto. Sem esta guarda, uma chocagem que falhou por rede deixava
    # companion.json descrevendo o bicho já graduado (ou liberado), e a absorção
    # seguinte o acrescentava de novo como entrada aberta: o mesmo indivíduo
    # aparecia duas vezes, e o graduado voltava a ser companion no estágio 0.
    if any(e.get("companionId") == key for e in collection["entries"]):
        # O Mint troca a natureza do companion vivo. A entrada dele tem de
        # acompanhar, senão o histórico descreve a natureza antiga. Só a ABERTA:
        # uma entrada fechada guarda a natureza que aquele indivíduo tinha, e
        # reescrevê-la seria reescrever o passado.
        aberta = open_entry(collection)
        if (aberta is not None and aberta.get("companionId") == key
                and aberta.get("nature") != companion.get("nature")):
            aberta["nature"] = companion.get("nature")
            changed = True
        return changed

    if open_entry(collection) is None:
        collection["entries"].append(entry_from_companion(companion, now))
        changed = True

    return changed


def record_stage(collection: dict, stage: int) -> bool:
    """Marca até onde o companion atual chegou. Nunca regride."""
    entry = open_entry(collection)
    if entry is None:
        return False
    reached = max(int(entry.get("finalStage") or 0), int(stage))
    if reached == entry.get("finalStage"):
        return False
    entry["finalStage"] = reached
    return True


def release_open_entry(collection: dict, now: int) -> bool:
    """Fecha a entrada aberta como LIBERADA (descartada por compra de ovo).

    Distinto de graduar: a entrada aparece no Pokédex e no histórico com as
    formas alcançadas, mas `has_graduated_line` não a conta, então não paga o
    bônus de crescimento 2×.
    """
    entry = open_entry(collection)
    if entry is None:
        return False
    entry["releasedAt"] = now
    return True


def close_open_entry(collection: dict, now: int, final_stage: int) -> bool:
    """Fecha a entrada aberta na graduação. No-op se não houver nenhuma."""
    entry = open_entry(collection)
    if entry is None:
        return False
    entry["graduatedAt"] = now
    entry["finalStage"] = max(int(entry.get("finalStage") or 0), int(final_stage))
    return True


# ---- Subcomandos ----------------------------------------------------------


def companion_path() -> str:
    return os.path.join(state_dir(), "companion.json")


def cmd_hatch(argv: list[str]) -> int:
    state = load_state()
    # O grau garantido vem do estado (comprado antes, possivelmente offline);
    # um argumento explícito existe só para testar e para `hatch rare` na mão.
    tier = argv[0] if argv else state.get("eggTier")
    if tier not in EGG_TIERS:
        tier = None

    collection = load_collection()
    entries = load_index()
    entry = pick_species(entries, tier=tier, collection=collection)

    if entry is None:
        # Piso sem candidato: a pessoa MANTÉM a garantia e tenta de novo no
        # próximo tick. Cair para o pool inteiro entregaria menos do que ela
        # pagou.
        log(f"nenhuma espécie atende o piso {tier!r}; a garantia continua valendo")
        return 1

    shiny = roll_shiny(denominator=shiny_denominator(state.get("inventory")))
    line = hydrate_sprites(evolution_line(entry["id"]), shiny)
    now = int(time.time())
    rarity = rarity_for(entry)
    disguised = roll_ditto(rarity, len(line))

    companion = {
        "schemaVersion": 1,
        "companionId": uuid.uuid4().hex[:12],
        "baseSpeciesId": entry["id"],
        "name": entry["name"],
        "rarity": rarity,
        "shiny": shiny,
        # Só rótulo: existe para o Mint ter o que re-sortear. Sem stats, porque
        # o bloco de individualidade ficou fora de escopo.
        "nature": random.choice(NATURES),
        "dittoDisguise": disguised,
        "dittoRevealed": False,
        "captureRate": entry["captureRate"],
        "evolutionLine": line,
        "hatchedAt": now,
    }
    write_json(companion_path(), companion)

    # O grau é consumido exatamente aqui, na chocagem que o honrou.
    if state.get("eggTier") is not None:
        state["eggTier"] = None
        write_json(state_path(), state)

    # A entrada de catch log nasce junto com o companion: o Pokémon entra no
    # Pokédex assim que choca, não só quando gradua.
    if sync_open_entry(collection, companion, now):
        save_collection(collection)

    nome = entry["name"].replace("-", " ").title()
    if shiny:
        notify("✨ Shiny!", f"A shiny {nome} hatched — that is 1 in "
                           f"{shiny_denominator(state.get('inventory'))}.")
    else:
        notify("Hatched!", f"{nome} ({rarity_for(entry)})")

    log(f"chocou {entry['name']} ({rarity_for(entry)})"
        f"{' SHINY' if shiny else ''}, linha de {len(line)} forma(s)")
    return 0


def cmd_sprites(argv: list[str]) -> int:
    if not argv:
        log("uso: omapkdex-sync sprites <id> [id...]")
        return 2
    for raw in argv:
        if not raw.isdigit():
            continue
        path = download_sprite(int(raw))
        log(f"{raw}: {path or 'indisponível'}")
    return 0


# ---- Detalhes de espécie (perfil do indivíduo) ---------------------------
#
# Uma consulta traz tudo que o perfil precisa: stats base, habilidades com slot
# e flag de oculta, learnset de nível, oitavos de fêmea, genus e descrição.
# São dados imutáveis, então o cache não expira.
#
# Idioma: inglês (id 9), fixo. A PokéAPI não tem pt-BR — medido na própria API:
# 0 descrições, 0 nomes de espécie, 0 nomes de golpe e 12 nomes de habilidade de
# ~370. Um seletor de idioma entregaria inglês em 100% dos casos.
DETAILS_LANG = 9

# O learnset é filtrado por version group porque um Pokémon aprende coisas
# diferentes em cada jogo, e uma lista com todos os grupos daria dezenas de
# entradas para o mesmo golpe. Black 2/White 2 é a geração V, que é o teto do
# pool de chocagem (é até onde existe sprite animado).
DETAILS_VERSION_GROUP = "black-2-white-2"

# move_learn_method_id 1 = level-up. O nome do campo é snake_case e NÃO se
# adivinha: `movelearnmethod_id` (que é como o relacionamento se chama) devolve
# "field not found". Descoberto por introspecção, depois de errar.
DETAILS_QUERY = """
query Details($id: Int!, $lang: Int!, $group: String!) {
  pokemon(
    where: {pokemon_species_id: {_eq: $id}, is_default: {_eq: true}}
    limit: 1
  ) {
    id
    name
    height
    weight
    pokemontypes(order_by: {slot: asc}) { type { name } }
    pokemonstats { base_stat stat { name } }
    pokemonabilities(order_by: {slot: asc}) {
      is_hidden
      slot
      ability { name }
    }
    pokemonmoves(
      where: {move_learn_method_id: {_eq: 1}, versiongroup: {name: {_eq: $group}}}
      order_by: {level: asc}
    ) {
      level
      move { name }
    }
  }
  pokemonspecies(where: {id: {_eq: $id}}) {
    gender_rate
    capture_rate
    pokemonspeciesnames(where: {language_id: {_eq: $lang}}) { genus }
    pokemonspeciesflavortexts(where: {language_id: {_eq: $lang}}, limit: 1) {
      flavor_text
    }
  }
}
"""


def details_path(species_id: int) -> str:
    return os.path.join(cache_dir(), "details", f"{int(species_id)}.json")


def clean_flavor(text: str) -> str:
    """Achata o flavor text da PokéAPI numa linha.

    Ele vem com as quebras de linha do jogo e um \f separando páginas; renderizar
    isso cru abre buracos na coluna estreita do painel.
    """
    s = str(text or "")
    for ch in ("\n", "\r", "\f", "\x0c", "\u00ad"):
        s = s.replace(ch, " ")
    return " ".join(s.split())


def normalize_details_graphql(payload: dict | None, species_id: int) -> dict | None:
    """Converte o payload da consulta na forma que o Profile.js consome.

    Devolve None quando não há forma default para a espécie — sem stats base não
    há perfil, e cachear um objeto vazio faria a view mostrar um perfil quebrado
    para sempre, sem nunca tentar de novo.
    """
    data = (payload or {}).get("data") or {}
    formas = data.get("pokemon") or []
    if not formas:
        return None
    forma = formas[0]

    especies = data.get("pokemonspecies") or []
    especie = especies[0] if especies else {}

    stats = {}
    for row in forma.get("pokemonstats") or []:
        nome = ((row.get("stat") or {}).get("name"))
        if nome and isinstance(row.get("base_stat"), int):
            stats[nome] = row["base_stat"]

    habilidades = []
    for row in forma.get("pokemonabilities") or []:
        nome = ((row.get("ability") or {}).get("name"))
        if not nome:
            continue
        habilidades.append({"name": nome, "slot": int(row.get("slot") or 0),
                            "isHidden": bool(row.get("is_hidden"))})

    golpes = []
    for row in forma.get("pokemonmoves") or []:
        nome = ((row.get("move") or {}).get("name"))
        if not nome:
            continue
        golpes.append({"name": nome, "level": int(row.get("level") or 0)})

    tipos = [((row.get("type") or {}).get("name"))
             for row in forma.get("pokemontypes") or []]

    nomes = especie.get("pokemonspeciesnames") or []
    textos = especie.get("pokemonspeciesflavortexts") or []

    return {
        "schemaVersion": 1,
        "speciesId": int(species_id),
        "name": forma.get("name") or str(species_id),
        "genus": (nomes[0].get("genus") if nomes else "") or "",
        "flavorText": clean_flavor(textos[0].get("flavor_text")) if textos else "",
        "height": forma.get("height"),
        "weight": forma.get("weight"),
        "types": [t for t in tipos if t],
        # −1 (sem gênero) e não 0 (sempre macho) quando a espécie não veio: um
        # default de 0 afirmaria algo falso sobre o bicho.
        "genderRate": especie.get("gender_rate") if isinstance(
            especie.get("gender_rate"), int) else -1,
        "captureRate": especie.get("capture_rate"),
        "baseStats": stats,
        "abilities": habilidades,
        "moves": golpes,
    }


def fetch_details_graphql(species_id: int) -> dict:
    check_host(GRAPHQL_ENDPOINT)
    body = json.dumps({
        "query": DETAILS_QUERY,
        "variables": {"id": int(species_id), "lang": DETAILS_LANG,
                      "group": DETAILS_VERSION_GROUP},
    })
    request = urllib.request.Request(
        GRAPHQL_ENDPOINT,
        data=body.encode(),
        headers={"User-Agent": USER_AGENT, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.loads(response.read())


def fetch_details_rest(species_id: int) -> dict | None:
    """Plano B: /pokemon/{id} e /pokemon-species/{id}, duas requisições.

    Existe pelo mesmo motivo do fallback do índice: o endpoint GraphQL já caiu
    neste projeto. Sem ele, um GraphQL fora deixaria o perfil inacessível mesmo
    com a REST no ar. Os nomes vêm em slug, que é o bastante — a UI é em inglês,
    e "hyper-cutter" viram "Hyper Cutter" na formatação.
    """
    mon = fetch(f"{API}/pokemon/{int(species_id)}")
    especie = fetch(f"{API}/pokemon-species/{int(species_id)}")

    stats = {}
    for row in mon.get("stats") or []:
        nome = ((row.get("stat") or {}).get("name"))
        if nome and isinstance(row.get("base_stat"), int):
            stats[nome] = row["base_stat"]
    if not stats:
        return None

    habilidades = []
    for row in mon.get("abilities") or []:
        nome = ((row.get("ability") or {}).get("name"))
        if not nome:
            continue
        habilidades.append({"name": nome, "slot": int(row.get("slot") or 0),
                            "isHidden": bool(row.get("is_hidden"))})

    golpes = []
    for row in mon.get("moves") or []:
        nome = ((row.get("move") or {}).get("name"))
        if not nome:
            continue
        melhor = None
        for detalhe in row.get("version_group_details") or []:
            metodo = ((detalhe.get("move_learn_method") or {}).get("name"))
            grupo = ((detalhe.get("version_group") or {}).get("name"))
            if metodo != "level-up" or grupo != DETAILS_VERSION_GROUP:
                continue
            nivel = int(detalhe.get("level_learned_at") or 0)
            melhor = nivel if melhor is None else min(melhor, nivel)
        if melhor is not None:
            golpes.append({"name": nome, "level": melhor})
    golpes.sort(key=lambda g: (g["level"], g["name"]))

    genus = ""
    for row in especie.get("genera") or []:
        if ((row.get("language") or {}).get("name")) == "en":
            genus = row.get("genus") or ""
            break

    flavor = ""
    for row in especie.get("flavor_text_entries") or []:
        if ((row.get("language") or {}).get("name")) == "en":
            flavor = clean_flavor(row.get("flavor_text"))
            break

    return {
        "schemaVersion": 1,
        "speciesId": int(species_id),
        "name": mon.get("name") or str(species_id),
        "genus": genus,
        "flavorText": flavor,
        "height": mon.get("height"),
        "weight": mon.get("weight"),
        "types": [((t.get("type") or {}).get("name"))
                  for t in sorted(mon.get("types") or [],
                                  key=lambda t: t.get("slot") or 0)
                  if (t.get("type") or {}).get("name")],
        "genderRate": especie.get("gender_rate") if isinstance(
            especie.get("gender_rate"), int) else -1,
        "captureRate": especie.get("capture_rate"),
        "baseStats": stats,
        "abilities": habilidades,
        "moves": golpes,
    }


def cmd_details(argv: list[str]) -> int:
    """details <speciesId> — busca e cacheia os dados de espécie do perfil."""
    if not argv or not str(argv[0]).isdigit():
        log("uso: omapkdex-sync details <speciesId>")
        return 2
    species_id = int(argv[0])
    if not 1 <= species_id <= MAX_SPECIES:
        log(f"espécie fora da faixa 1-{MAX_SPECIES}: {species_id}")
        return 2

    caminho = details_path(species_id)
    # isfile, não exists: um diretório com esse nome (ou qualquer coisa que não
    # seja arquivo) fazia o subcomando devolver 0 sem escrever nada. O QML
    # relia, falhava de novo, disparava o helper de novo — laço infinito de
    # processos, encontrado em teste.
    if os.path.isfile(caminho):
        return 0

    dados = None
    try:
        dados = normalize_details_graphql(fetch_details_graphql(species_id),
                                          species_id)
    except Exception as exc:  # noqa: BLE001
        log(f"GraphQL de detalhes falhou ({exc})")

    if dados is None:
        try:
            dados = fetch_details_rest(species_id)
        except Exception as exc:  # noqa: BLE001
            log(f"REST de detalhes falhou ({exc})")

    if dados is None:
        # Nada de cache: a view mostra a falha com um botão de tentar de novo, e
        # a próxima tentativa busca de verdade.
        log(f"não foi possível obter os detalhes da espécie {species_id}")
        return 1

    write_json(caminho, dados)
    log(f"detalhes de {dados['name']} em cache")
    return 0


def cmd_index(_argv: list[str]) -> int:
    entries = load_index(rebuild=True)
    counts: dict[str, int] = {}
    for entry in entries:
        rarity = rarity_for(entry)
        counts[rarity] = counts.get(rarity, 0) + 1
    log(f"{len(entries)} espécies base: {counts}")
    return 0


# Quanto uma compra ou uso espera pelo lock antes de desistir. O absorb pode
# segurá-lo durante rede (a chocagem roda dentro dele), então esperar um pouco é
# normal; esperar para sempre faria o clique na loja não fazer nada visível.
LOCK_TIMEOUT = 8.0


def _acquire(lock, timeout: float = LOCK_TIMEOUT) -> bool:
    """Tenta o flock até `timeout`. Devolve se conseguiu."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.1)


def _with_state_lock(fn, after=None):
    """Roda `fn(state)` sob o mesmo flock do absorb, salvando se devolver True.

    Compras e usos precisam do mesmo lock que a absorção: sem isso um absorb
    concorrente sobrescreve a compra, ou vice-versa.

    `after` roda TAMBÉM dentro do lock, depois da escrita do estado. É onde
    entram a escrita da coleção e a chocagem — elas rodavam fora do lock, que é
    exatamente o que o invariante de docs/desenvolvimento.md proíbe.
    """
    os.makedirs(state_dir(), exist_ok=True)
    with open(lock_path(), "w") as lock:
        if not _acquire(lock):
            log("outra operação está em curso; tente de novo em instantes")
            return False
        state = load_state()
        result = fn(state)
        if not result:
            return False
        write_json(state_path(), state)
        if after is not None:
            after()
        return True


def cmd_buy(argv: list[str]) -> int:
    """buy <rareCandy|mint|shinyCharm|egg> <shopDifficulty> [grau]"""
    if not argv:
        log("uso: omapkdex-sync buy <item|egg> <shopDifficulty> [grau]")
        return 2
    what = argv[0]
    shop_difficulty = clamp_difficulty(argv[1] if len(argv) > 1 else DIFFICULTY_DEFAULT)
    tier = argv[2] if len(argv) > 2 else None

    if what == "egg":
        if tier not in EGG_TIERS:
            log(f"grau de ovo inválido: {tier!r} (aceitos: {EGG_TIERS})")
            return 2
        entry = f"egg:{tier or ''}"
    elif what in BASE_PRICES:
        entry = what
    else:
        log(f"item desconhecido: {what}")
        return 2

    price = shop_price(entry, shop_difficulty)
    companion = load_companion()

    def apply(state):
        inventory = state.setdefault("inventory", {})

        # Passivo é compra única: comprar de novo não cobra nem faz nada.
        if what in PASSIVE_ITEMS and inventory.get(what):
            log(f"{what} já é seu (item passivo, compra única)")
            return False

        # Ovo descarta o companion atual; sem companion não há o que descartar.
        if what == "egg" and not (state.get("hatched") and companion):
            log("não há companion para descartar — você já está num ovo")
            return False

        if available_tokens(state) < price:
            log(f"saldo insuficiente: {available_tokens(state)} < {price}")
            return False

        state["spentTokens"] = int(state.get("spentTokens") or 0) + price

        if what == "egg":
            # O grau é PERSISTIDO, não resolvido agora: sortear espécie precisa
            # de rede, e comprar offline não pode queimar tokens sem entregar.
            state["eggTier"] = tier
            state["hatched"] = False
            state["stage"] = 0
            # Perder o progresso acumulado é o custo real do re-roll, e é o que
            # impede farmar chocagens.
            state["tokensIntoStage"] = 0
        else:
            if what in PASSIVE_ITEMS:
                inventory[what] = True
            else:
                inventory[what] = int(inventory.get(what) or 0) + 1

        return True

    def depois():
        """Roda dentro do lock, depois da escrita do estado."""
        if what != "egg":
            return
        # O descartado NÃO desaparece: entra no histórico marcado como liberado,
        # com as formas alcançadas. O que ele não faz é entrar na contagem de
        # linhas graduadas, então não paga o bônus de 2×.
        collection = load_collection()
        if release_open_entry(collection, int(time.time())):
            save_collection(collection)
        # O companion.json do liberado tem de sair: se a chocagem abaixo falhar
        # por rede, deixá-lo no lugar faria o painel mostrar a linha evolutiva de
        # quem acabou de ser descartado.
        try:
            os.unlink(companion_path())
        except FileNotFoundError:
            pass
        # Pré-sorteio da espécie nova. Se a rede estiver fora, o grau pago
        # continua em state["eggTier"] e a próxima tentativa o honra.
        try:
            cmd_hatch([])
        except Exception as exc:  # noqa: BLE001
            log(f"pré-sorteio falhou ({exc}); o ovo e a garantia continuam seus")

    if not _with_state_lock(apply, depois):
        return 1

    log(f"comprou {entry} por {price}")
    return 0


def cmd_use(argv: list[str]) -> int:
    """use <rareCandy|mint> <growthDifficulty>"""
    if not argv:
        log("uso: omapkdex-sync use <rareCandy|mint> <growthDifficulty>")
        return 2
    what = argv[0]
    difficulty = clamp_difficulty(argv[1] if len(argv) > 1 else DIFFICULTY_DEFAULT)

    if what not in ("rareCandy", "mint"):
        log(f"item não usável: {what}")
        return 2

    companion = load_companion()
    line = (companion or {}).get("evolutionLine") or []

    if what == "mint":
        # O Mint não precisa da linha carregada; só de um companion.
        if not companion:
            log("sem companion para aplicar o Mint")
            return 1

        atual = companion.get("nature")
        # Escolhe entre as outras 24, então a nature SEMPRE muda — o original faz
        # igual, senão pagar por um Mint e não ver diferença parece bug.
        opcoes = [n for n in NATURES if n != atual] or list(NATURES)
        nova = random.choice(opcoes)

        def apply_mint(state):
            inventory = state.setdefault("inventory", {})
            if int(inventory.get("mint") or 0) <= 0:
                log("sem Mint no inventário")
                return False
            inventory["mint"] = int(inventory["mint"]) - 1
            return True

        if not _with_state_lock(apply_mint):
            return 1

        companion["nature"] = nova
        write_json(companion_path(), companion)
        log(f"nature: {atual} -> {nova}")
        return 0

    # rareCandy: exige a linha carregada, senão a candy seria gasta sem que dê
    # para checar evolução — o original tem a mesma guarda.
    if not companion or not line:
        log("sem companion (ou sem linha evolutiva) para usar a candy")
        return 1

    rarity = companion.get("rarity") or "common"
    total_forms = max(1, len(line))
    boost = growth_boost(load_collection(), companion)
    graduated = {"yes": False}

    def apply_candy(state):
        inventory = state.setdefault("inventory", {})
        if int(inventory.get("rareCandy") or 0) <= 0:
            log("sem Rare Candy no inventário")
            return False
        if not state.get("hatched"):
            log("a candy só serve num Pokémon chocado")
            return False

        inventory["rareCandy"] = int(inventory["rareCandy"]) - 1
        # O XP entra SÓ no progresso. Somar a lifetimeTokens faria de cada candy
        # uma máquina de dinheiro, porque a carteira é lifetime − spent.
        # E não é escalado pela dificuldade: escalar os dois se cancelaria.
        state["tokensIntoStage"] = int(state.get("tokensIntoStage") or 0) + RARE_CANDY_XP
        graduated["yes"] = advance_stages(state, rarity, total_forms, difficulty, boost)
        return True

    def depois():
        """Roda dentro do lock, depois da escrita do estado."""
        collection = load_collection()
        now = int(time.time())
        if graduated["yes"]:
            if close_open_entry(collection, now, total_forms - 1):
                save_collection(collection)
            try:
                cmd_hatch([])
            except Exception as exc:  # noqa: BLE001
                log(f"chocagem do ovo novo falhou ({exc}); será tentada de novo")
        else:
            state = load_state()
            if record_stage(collection, int(state.get("stage") or 0)):
                save_collection(collection)

    if not _with_state_lock(apply_candy, depois):
        return 1

    log(f"usou uma Rare Candy (+{RARE_CANDY_XP})"
        + (" e graduou" if graduated["yes"] else ""))
    return 0


COMMANDS = {"hatch": cmd_hatch, "sprites": cmd_sprites,
            "index": cmd_index, "absorb": cmd_absorb,
            "buy": cmd_buy, "use": cmd_use, "details": cmd_details}


def main(argv: list[str]) -> int:
    # Ausência de subcomando NÃO é "hatch". O default antigo fazia
    # `./bin/omapkdex-sync` — o comando que qualquer pessoa roda só para ver se
    # o helper responde — despejar o companion ativo e chocar outro no lugar,
    # porque cmd_hatch choca incondicionalmente: o guard de "só choca quando o
    # ovo está pronto" vive no QML, não aqui. Perda de dado silenciosa disparada
    # pelo comando mais inofensivo que existe. Imprimir o uso é o que se espera.
    command = argv[0] if argv else ""
    handler = COMMANDS.get(command)
    if not handler:
        if command:
            log(f"subcomando desconhecido: {command}")
        else:
            log("uso: omapkdex-sync <subcomando> [argumentos]")
        log(f"disponíveis: {', '.join(sorted(COMMANDS))}")
        return 2
    try:
        return handler(argv[1:])
    except Exception as exc:  # noqa: BLE001 - o QML só olha o exit code
        log(f"erro: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
